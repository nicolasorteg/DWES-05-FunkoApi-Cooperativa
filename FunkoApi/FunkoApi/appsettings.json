{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cache": { 
    "CacheSize": 1000, 
    "DefaultExpirationMinutes": 30, 
    "SlidingExpirationMinutes": 10
  }, 
