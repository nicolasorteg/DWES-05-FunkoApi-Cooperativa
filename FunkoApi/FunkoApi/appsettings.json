{
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "log/log-.txt",
          "retainedFileCountLimit": 5,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Cache": { 
    "CacheSize": 1000, 
    "DefaultExpirationMinutes": 30, 
    "SlidingExpirationMinutes": 10
  }, 
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "ConnectionStrings": { 
    "PostgresConnection": "Host=localhost;Port=5432;Database=funkos_db;Username=postgres;Password=postgres",
    "MongoConnection": "mongodb://localhost:27017"
  },
  "MongoDatabase": {
    "DatabaseName": "funkos_mongo_db"
  },
  "EmailSettings": {
    "Server": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "FunkoApi Store",
    "SenderEmail": "tu-email@gmail.com",
    "UserName": "tu-email@gmail.com",
    "Password": "tu-app-password",
    "EnableSsl": true
  },
  "Jwt": { 
    "Key": "SuperSecretKey_ParaFirmarLosTokensJWT_FunkoApi_2026!", 
    "Issuer": "FunkoApi", 
    "Audience": "FunkoApiClients",
    "ExpirationMin": 60
  }
}